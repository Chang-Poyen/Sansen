# Copy to bridge.env (ignored by Git) and fill in your own SSH settings.
VB_REMOTE_HOST=your-eda-ssh-host
VB_REMOTE_USER=your-ssh-user
VB_SPECTRE_BIN=/eda/cadence/SPECTRE181/bin/spectre
VB_DISABLE_CONTROL_MASTER=true
# Choose a distinct name per team member (even when sharing one SSH account).
VB_CLIENT_ID=your-name
